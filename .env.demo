# =============================================================================
# mindvaults Demo 环境配置
# 部署方式：docker compose --env-file .env.demo up -d
# =============================================================================

# --- 应用 ---
APP_ENV=production
APP_DEBUG=false
API_KEY=change-me-in-production
CORS_ORIGINS=https://mindvaults.app,http://localhost:3000,http://localhost

# --- 数据库 ---
DATABASE_URL=postgresql+asyncpg://mindvaults:mindvaults@db:5432/mindvaults

# --- Redis ---
REDIS_URL=redis://redis:6379
REDIS_CACHE_ENABLED=true

# --- LLM (云端 API) — 用户自行填入 Key ---
LLM_PROVIDER=openai
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_MODEL=deepseek-chat
LLM_API_KEY=

# --- Embedding (云端 API) — 用户自行填入 Key ---
EMBEDDING_PROVIDER=openai
EMBEDDING_BASE_URL=https://api.openai.com/v1
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIM=1536
EMBEDDING_API_KEY=

# --- Demo 安全限制 ---
DEMO_MODE=true
MAX_UPLOAD_SIZE_MB=5
MAX_FILES_PER_UPLOAD=10
ALLOWED_EXTENSIONS=txt,md,pdf,docx
CHAT_RATE_LIMIT=10/minute
UPLOAD_RATE_LIMIT=5/minute
# Vault 路径扫描已禁用，拖拽上传上限 20 个文件

# --- 上传 ---
UPLOAD_DIR=/app/uploads

# --- 前端 ---
# 留空 = 前端走相对路径 /api/v1/...，通过 Nginx 代理到后端
# 如有独立后端域名再填完整 URL，如 https://api.mindvaults.app
NEXT_PUBLIC_API_BASE_URL=
NEXT_PUBLIC_DEMO_MODE=true
